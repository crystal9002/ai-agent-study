# ===== LLM（OpenAI 兼容，三选一填法）=====
# OpenAI 官方
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key
LLM_MODEL=gpt-4o-mini

# DeepSeek 示例：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ===== Embedding =====
# local = 本地 sentence-transformers（默认，免 API、免联网 Key）
# api   = 走 API
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# API 模式下使用：
# EMBEDDING_PROVIDER=api
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=sk-your-key

# ===== 召回模式 =====
# hybrid（默认）= 向量 + BM25 混合召回，RRF 融合（精确串/型号类查询必备）
# vector        = 仅向量召回
RETRIEVAL_MODE=hybrid

# ===== 重排 =====
# 0 = 关闭重排（调试提速用）
RERANK_ENABLED=1
RERANK_MODEL=BAAI/bge-reranker-base
# 中文生产推荐：BAAI/bge-reranker-v2-m3

# ===== 索引目录 =====
INDEX_DIR=index

# ===== 向量库后端（原生与框架同名，取值见各脚本）=====
# 原生 01~03：faiss（默认）| sqlite
# LlamaIndex 04：simple（默认，内置）| faiss（需 llama-index-vector-stores-faiss）
# LangChain 05：faiss（默认）| sqlite
VECTOR_STORE=faiss

# ===== 分块策略（重建索引后生效）=====
# recursive = 通用递归切分（默认）
# markdown  = 按 # 标题切章节（Markdown 文档首选）
# sentence  = 句子滑窗，粒度最细（FAQ/短文本）
CHUNK_STRATEGY=recursive
