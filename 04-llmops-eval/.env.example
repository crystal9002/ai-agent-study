# ===== LLM（OpenAI 兼容，DeepSeek / OpenAI / 通义 / 方舟 / vLLM 均可）=====
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat

# Judge 专用模型（不填则复用 LLM_MODEL；可用更便宜的模型跑裁判）
# JUDGE_MODEL=deepseek-chat

# ===== Web 仪表盘 =====
HOST=127.0.0.1
PORT=8003

# ===== 成本估算（美元 / 百万 token；不填按内置默认价目表）=====
# PRICE_IN_PER_M=0.27
# PRICE_OUT_PER_M=1.10

# ===== 回归检测阈值（04_report.py；指标下降超过该值标红）=====
# REGRESSION_THRESHOLD=0.05

# ===== Langfuse（scripts/06_langfuse.py；不填则打印接入指引后退出）=====
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
