# ===== LLM（OpenAI 兼容）=====
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=sk-your-key
LLM_MODEL=deepseek-chat

# ===== Web（scripts/03_web.py）=====
HOST=127.0.0.1
PORT=8004

# ===== 安全层开关 =====
# 审批等待：deny = 非交互直接拒绝（default-deny，默认）；ask = 等待人工批准
APPROVAL_MODE=deny
# 人工审批最长等待秒数（ask 模式生效）
APPROVAL_WAIT_SECONDS=60
# 注入检测的可选 LLM 审核层：0 = 关闭（默认，确定性）；1 = 正则命中后再用 LLM 复核
INJECTION_LLM_REVIEW=0
# 审计日志目录
AUDIT_DIR=audit
